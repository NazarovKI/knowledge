й, способствующих избавлению от порока, на завтра (предстоящий период 5-6 пунктов).":[37,37],"#14. По памяти левой рукой написать формулы, способствующие новому отношению к пороку.":[38,41],"#14. По памяти левой рукой написать формулы, способствующие новому отношению к пороку.#{1}":[40,41]},"outlinks":[],"metadata":{"draft":true},"task_lines":[],"tasks":{},"codeblock_ranges":[]},"smart_blocks:daily/2025-02-03.md#---frontmatter---": {"path":null,"last_embed":{"hash":null},"embeddings":{},"text":null,"length":0,"last_read":{"hash":"1f607ku","at":1782398695676},"key":"daily/2025-02-03.md#---frontmatter---","lines":[1,3],"size":19,"outlinks":[],"class_name":"SmartBlock"},

\u1042\'3f\u1090\'3f\u1086\'3f\u1088\'3f\u1078\'3f\u1077\'3f\u1085\'3f\u1080\'3f\u1077\'3f \u1084\'3f\u1072\'3f\u1088\'3f\u1089\'3f\u1080\'3f\u1072\'3f\u1085\'3f \u1079\'3f\u1072\'3f\u1089\'3f\u1090\'3f\u1072\'3f\u1083\'3f\u1086\'3f \u1047\'3f\u1077\'3f\u1084\'3f\u1083\'3f\u1102\'3f \u1074\'3f\u1088\'3f\u1072\'3f\u1089\'3f\u1087\'3f\u1083\'3f\u1086\'3f\u1093\'3f, \u1103\'3f\u1074\'3f\u1080\'3f\u1083\'3f\u1086\'3f\u1089\'3f\u1100\'3f \u1075\'3f\u1088\'3f\u1086\'3f\u1079\'3f\u1085\'3f\u1099\'3f\u1084\'3f \u1080\'3f\u1089\'3f\u1087\'3f\u1099\'3f\u1090\'3f\u1072\'3f\u1085\'3f\u1080\'3f\u1077\'3f\u1084\'3f \u1076\'3f\u1083\'3f\u1103\'3f \u1095\'3f\u1077\'3f\u1083\'3f\u1086\'3f\u1074\'3f\u1077\'3f\u1095\'3f\u1077\'3f\u1089\'3f\u1090\'3f\u1074\'3f\u1072\'3f, \u1089\'3f \u1095\'3f\u1091\'3f\u1074\'3f\u1089\'3f\u1090\'3f\u1074\'3f\u1086\'3f\u1084\'3f \u1087\'3f\u1086\'3f\u1083\'3f\u1085\'3f\u1086\'3f\u1081\'3f \u1073\'3f\u1077\'3f\u1079\'3f\u1086\'3f\u1087\'3f\u1072\'3f\u1089\'3f\u1085\'3f\u1086\'3f\u1089\'3f\u1090\'3f\u1080\'3f \u1093\'3f\u1086\'3f\u1079\'3f\u1103\'3f\u1081\'3f\u1085\'3f\u1080\'3f\u1095\'3f\u1072\'3f\u1074\'3f\u1096\'3f\u1077\'3f\u1075\'3f\u1086\'3f \u1085\'3f\u1072\'3f \u1079\'3f\u1077\'3f\u1084\'3f\u1085\'3f\u1086\'3f\u1084\'3f \u1096\'3f\u1072\'3f\u1088\'3f\u1077\'3f.}
\par \pard\plain \s0\rtlch\af10\afs24\alang1081 \ltrch\lang1049\langfe2052\hich\af6\loch\ql\nowidctlpar\hyphpar0\ltrpar\cf0\f6\fs24\lang1049\kerning1\dbch\af9\langfe2052\sl360\slmult1\qj\tx916\tx1832\tx2748\tx3664\tx4580\tx5496\tx6412\tx7328\tx8244\tx9160\tx10076\tx10992\tx11908\tx12824\tx13740\tx14656\li0\ri0\lin0\rin0\fi709{\hich\af5\loch\scaps0\caps0\fs28\b0\f5\loch
\u1053\'3f\u1080\'3f \u1073\'3f\u1091\'3f\u1088\'3f\u1078\'3f\u1091\'3f\u1072\'3f\u1079\'3f\u1085\'3f\u1086\'3f\u1077\'3f \u1086\'3f\u1073\'3f\u1097\'3f\u1077\'3f\u1089\'3f\u1090\'3f\u1074\'3f\u1086\'3f, \u1085\'3f\u1080\'3f \u1089\'3f\u1086\'3f\u1074\'3f\u1088\'3f\u1077\'3f\u1084\'3f\u1077\'3f\u1085\'3f\u1085\'3f\u1099\'3f\u1081\'3f \u1059\'3f\u1101\'3f\u1083\'3f\u1083\'3f\u1089\'3f\u1091\'3f \u1095\'3f\u1077\'3f\u1083\'3f\u1086\'3f\u1074\'3f\u1077\'3f\u1082\'3f \u1085\'3f\u1077\'3f \u1074\'3f\u1099\'3f\u1076\'3f\u1077\'3f\u1088\'3f\u1078\'3f\u1080\'3f\u1074\'3f\u1072\'3f\u1102\'3f\u1090\'3f \u1101\'3f\u1090\'3f\u1086\'3f\u1081\'3f \u1088\'3f\u1077\'3f\u1096\'3f\u1072\'3f\u1102\'3f\u1097\'3f\u1077\'3f\u1081\'3f \u1087\'3f\u1088\'3f\u1086\'3f\u1074\'3f\u1077\'3f\u1088\'3f\u1082\'3f\u1080\'3f. \u1048\'3f \u1074\'3f\u1089\'3f\u1077\'3f \u1078\'3f\u1077\'3f \u1101\'3f\u1090\'3f\u1086\'3f\u1090\'3f \u1088\'3f\u1086\'3f\u1084\'3f\u1072\'3f\u1085\'3f \u1085\'3f\u1077\'3f \u1076\'3f\u1072\'3f\u1077\'3f\u1090\'3f \u1086\'3f\u1089\'3f\u1085\'3f\u1086\'3f\u1074\'3f\u1072\'3f\u1085\'3f\u1080\'3f\u1081\'3f \u1075\'3f\u1086\'3f\u1074\'3f\u1086\'3f\u1088\'3f\u1080\'3f\u1090\'3f\u1100\'3f \u1086\'3f \u1089\'3f\u1086\'3f\u1094\'3f\u1080\'3f\u1072\'3f\u1083\'3f\u1100\'3f\u1085\'3f\u1086\'3f\u1084\'3f \u1087\'3f\u1077\'3f\u1089\'3f\u1089\'3f\u1080\'3f\u1084\'3f\u1080\'3f\u1079\'3f\u1084\'3f\u1077\'3f \u1059\'3f\u1101\'3f\u1083\'3f\u1083\'3f\u1089\'3f\u1072\'3f. \u1057\'3f\u1080\'3f\u1084\'3f\u1074\'3f\u1086\'3f\u1083\'3f\u1080\'3f\u1095\'3f\u1077\'3f\u1089\'3f\u1082\'3f\u1072\'3f\u1103\'3f \u1082\'3f\u1086\'3f\u1085\'3f\u1094\'3f\u1086\'3f\u1074\'3f\u1082\'3f\u1072\'3f \u1088\'3f\u1086\'3f\u1084\'3f\u1072\'3f\u1085\'3f\u1072\'3f - \u1085\'3f\u1077\'3f\u1086\'3f\u1078\'3f\u1080\'3f\u1076\'3f\u1072\'3f\u1085\'3f\u1085\'3f\u1072\'3f\u1103\'3f \u1075\'3f\u1080\'3f\u1073\'3f\u1077\'3f\u1083\'3f\u1100\'3f \u1084\'3f\u1072\'3f\u1088\'3f\u1089\'3f\u1080\'3f\u1072\'3f\u1085\'3f, \u1085\'3f\u1077\'3f \u1087\'3f\u1088\'3f\u1080\'3f\u1089\'3f\u1087\'3f\u1086\'3f\u1089\'3f\u1086\'3f\u1073\'3f\u1083\'3f\u1077\'3f\u1085\'3f\u1085\'3f\u1099\'3f\u1093\'3f \u1082\'3f \u1079\'3f\u1077\'3f\u1084\'3f\u1085\'3f\u1099\'3f\u1084\'3f \u1091\'3f\u1089\'3f\u1083\'3f\u1086\'3f\u1074\'3f\u1080\'3f\u1103\'3f\u1084\'3f, - \u1074\'3f\u1085\'3f\u1091\'3f\u1096\'3f\u1072\'3f\u1077\'3f\u1090\'3f \u1085\'3f\u1072\'3f\u1076\'3f\u1077\'3f\u1078\'3f\u1076\'3f\u1091\'3f \u1085\'3f\u1072\'3f \u1090\'3f\u1086\'3f, \u1095\'3f\u1090\'3f\u1086\'3f \u1087\'3f\u1086\'3f\u1083\'3f\u1077\'3f \u1086\'3f\u1082\'3f\u1086\'3f\u1085\'3f\u1095\'3f\u1072\'3f\u1090\'3f\u1077\'3f\u1083\'3f\u1100\'3f\u1085\'3f\u1086\'3f\u1081\'3f \u1073\'3f\u1080\'3f\u1090\'3f\u1074\'3f\u1099\'3f \u1085\'3f\u1072\'3f \u1047\'3f\u1077\'3f\u1084\'3f\u1083\'3f\u1077\'3f \u1086\'3f\u1089\'3f\u1090\'3f\u1072\'3f\u1085\'3f\u1077\'3f\u1090\'3f\u1089\'3f\u1103\'3f \u1074\'3f\u1089\'3f\u1077\'3f \u1078\'3f\u1077\'3f \u1079\'3f\u1072\'3f \u1095\'3f\u1077\'3f\u1083\'3f\u1086\'3f\u1074\'3f\u1077\'3f\u1082\'3f\u1086\'3f\u1084\'3f.}

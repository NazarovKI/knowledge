\u1057\'3f\u1090\'3f\u1088\'3f\u1077\'3f\u1084\'3f\u1103\'3f\u1089\'3f\u1100\'3f \u1086\'3f\u1073\'3f\u1086\'3f\u1075\'3f\u1072\'3f\u1090\'3f\u1080\'3f\u1090\'3f\u1100\'3f \u1088\'3f\u1077\'3f\u1089\'3f\u1091\'3f\u1088\'3f\u1089\'3f\u1099\'3f \u1092\'3f\u1072\'3f\u1085\'3f\u1090\'3f\u1072\'3f\u1089\'3f\u1090\'3f\u1080\'3f\u1082\'3f\u1080\'3f, \u1085\'3f\u1077\'3f\u1084\'3f\u1077\'3f\u1094\'3f\u1082\'3f\u1080\'3f\u1077\'3f \u1088\'3f\u1086\'3f\u1084\'3f\u1072\'3f\u1085\'3f\u1090\'3f\u1080\'3f\u1082\'3f\u1080\'3f <http://ru.wikipedia.org/w/index.php?title=%D0%9D%D0%B5%D0%BC%D0%B5%D1%86%D0%BA%D0%B8%D0%B9_%D1%80%D0%BE%D0%BC%D0%B0%D0%BD%D1%82%D0%B8%D0%B7%D0%BC&action=edit> \u1086\'3f\u1073\'3f\u1088\'3f\u1072\'3f\u1090\'3f\u1080\'3f\u1083\'3f\u1080\'3f\u1089\'3f\u1100\'3f \u1082\'3f \u1077\'3f\u1105\'3f \u1087\'3f\u1077\'3f\u1088\'3f\u1074\'3f\u1086\'3f\u1080\'3f\u1089\'3f\u1090\'3f\u1086\'3f\u1095\'3f\u1085\'3f\u1080\'3f\u1082\'3f\u1072\'3f\u1084\'3f - \u1089\'3f\u1086\'3f\u1073\'3f\u1088\'3f\u1072\'3f\u1083\'3f\u1080\'3f \u1080\'3f \u1086\'3f\u1073\'3f\u1088\'3f\u1072\'3f\u1073\'3f\u1086\'3f\u1090\'3f\u1072\'3f\u1083\'3f\u1080\'3f \u1074\'3f\u1086\'3f\u1083\'3f\u1096\'3f\u1077\'3f\u1073\'3f\u1085\'3f\u1099\'3f\u1077\'3f \u1089\'3f\u1082\'3f\u1072\'3f\u1079\'3f\u1082\'3f\u1080\'3f \u1080\'3f \u1083\'3f\u1077\'3f\u1075\'3f\u1077\'3f\u1085\'3f\u1076\'3f\u1099\'3f (\u171\'ab\u1053\'3f\u1072\'3f\u1088\'3f\u1086\'3f\u1076\'3f\u1085\'3f\u1099\'3f\u1077\'3f \u1089\'3f\u1082\'3f\u1072\'3f\u1079\'3f\u1082\'3f\u1080\'3f \u1055\'3f\u1077\'3f\u1090\'3f\u1077\'3f\u1088\'3f\u1072\'3f \u1051\'3f\u1077\'3f\u1073\'3f\u1088\'3f\u1077\'3f\u1093\'3f\u1090\'3f\u1072\'3f\u187\'bb <http://ru.wikipedia.org/w/index.php?title=%D0%9D%D0%B0%D1%80%D0%BE%D0%B4%D0%BD%D1%8B%D0%B5_%D1%81%D0%BA%D0%B0%D0%B7%D0%BA%D0%B8_%D0%9F%D0%B5%D1%82%D0%B5%D1%80%D0%B0_%D0%9B%D0%B5%D0%B1%D1%80%D0%B5%D1%85%D1%82%D0%B0&action=edit>, 1797 <http://ru.wikipedia.org/wiki/1797>, \u1074\'3f \u1086\'3f\u1073\'3f\u1088\'3f\u1072\'3f\u1073\'3f\u1086\'3f\u1090\'3f\u1082\'3f\u1077\'3f \u1058\'3f\u1080\'3f\u1082\'3f\u1072\'3f, \u171\'ab\u1044\'3f\u1077\'3f\u1090\'3f\u1089\'3f\u1082\'3f\u1080\'3f\u1077\'3f \u1080\'3f \u1089\'3f\u1077\'3f\u1084\'3f\u1077\'3f\u1081\'3f\u1085\'3f\u1099\'3f\u1077\'3f \u1089\'3f\u1082\'3f\u1072\'3f\u1079\'3f\u1082\'3f\u1080\'3f\u187\'bb, 1812 <http://ru.wikipedia.org/wiki/1812>-1814 <http://ru.wikipedia.org/wiki/1814>, \u1080\'3f \u171\'ab\u1053\'3f\u1077\'3f\u1084\'3f\u1077\'3f\u1094\'3f\u1082\'3f\u1080\'3f\u1077\'3f \u1087\'3f\u1088\'3f\u1077\'3f\u1076\'3f\u1072\'3f\u1085\'3f\u1080\'3f\u1103\'3f\u187\'bb, 1816 <http://ru.wikipedia.org/wiki/1816>-1818 <http://ru.wikipedia.org/wiki/1818>, \u1073\'3f\u1088\'3f\u1072\'3f\u1090\'3f\u1100\'3f\u1103\'3f \u1071\'3f. \u1080\'3f \u1042\'3f. \u1043\'3f\u1088\'3f\u1080\'3f\u1084\'3f\u1084\'3f <http://ru.wikipedia.org/wiki/%D0%91%D1%80%D0%B0%D1%82%D1%8C%D1%8F_%D0%93%D1%80%D0%B8%D0%BC%D0%BC>). \u1069\'3f\u1090\'3f\u1086\'3f \u1089\'3f\u1087\'3f\u1086\'3f\u1089\'3f\u1086\'3f\u1073\'3f\u1089\'3f\u1090\'3f\u1074\'3f\u1086\'3f\u1074\'3f\u1072\'3f\u1083\'3f\u1086\'3f \u1089\'3f\u1090\'3f\u1072\'3f\u1085\'3f\u1086\'3f\u1074\'3f\u1083\'3f\u1077\'3f\u1085\'3f\u1080\'3f\u1102\'3f \u1078\'3f\u1072\'3f\u1085\'3f\u1088\'3f\u1072\'3f \u1083\'3f\u1080\'3f\u1090\'3f\u1077\'3f\u1088\'3f\u1072\'3f\u1090\'3f\u1091\'3f\u1088\'3f\u1085\'3f\u1086\'3f\u1081\'3f \u1089\'3f\u1082\'3f\u1072\'3f\u1079\'3f\u1082\'3f\u1080\'3f <http://ru.wikipedia.org/w/index.php?title=%D0%9B%D0%B8%D1%82%D0%B5%D1%80%D0%B0%D1%82%D1%83%D1%80%D0%BD%D0%B0%D1%8F_%D1%81%D0%BA%D0%B0%D0%B7%D0%BA%D0%B0&action=edit> \u1074\'3f\u1086\'3f \u1074\'3f\u1089\'3f\u1077\'3f\u1093\'3f \u1077\'3f\u1074\'3f\u1088\'3f\u1086\'3f\u1087\'3f\u1077\'3f\u1081\'3f\u1089\'3f\u1082\'3f\u1080\'3f\u1093\'3f \u1083\'3f\u1080\'3f\u1090\'3f\u1077\'3f\u1088\'3f\u1072\'3f\u1090\'3f\u1091\'3f\u1088\'3f\u1072\'3f\u1093\'3f, \u1086\'3f\u1089\'3f\u1090\'3f\u1072\'3f\u1102\'3f\u1097\'3f\u1077\'3f\u1075\'3f\u1086\'3f\u1089\'3f\u1103\'3f \u1080\'3f \u1087\'3f\u1086\'3f\u1085\'3f\u1099\'3f\u1085\'3f\u1077\'3f \u1074\'3f\u1077\'3f\u1076\'3f\u1091\'3f\u1097\'3f\u1080\'3f\u1084\'3f \u1074\'3f \u1076\'3f\u1077\'3f\u1090\'3f\u1089\'3f\u1082\'3f\u1086\'3f\u1081\'3f \u1092\'3f\u1072\'3f\u1085\'3f\u1090\'3f\u1072\'3f\u1089\'3f\u1090\'3f\u1080\'3f\u1082\'3f\u1077\'3f. \u1050\'3f\u1083\'3f\u1072\'3f\u1089\'3f\u1089\'3f\u1080\'3f\u1095\'3f\u1077\'3f\u1089\'3f\u1082\'3f\u1080\'3f\u1081\'3f \u1077\'3f\u1075\'3f\u1086\'3f \u1086\'3f\u1073\'3f\u1088\'3f\u1072\'3f\u1079\'3f\u1077\'3f\u1094\'3f - \u1089\'3f\u1082\'3f\u1072\'3f\u1079\'3f\u1082\'3f\u1080\'3f \u1061\'3f. \u1050\'3f. \u1040\'3f\u1085\'3f\u1076\'3f\u1077\'3f\u1088\'3f\u1089\'3f\u1077\'3f\u1085\'3f\u1072\'3f <http://ru.wikipedia.org/wiki/%D0%90%D0%BD%D0%B4%D0%B5%D1%80%D1%81%D0%B5%D0%BD%2C_%D0%A5%D0%B0%D0%BD%D1%81_%D0%9A%D1%80%D0%B8%D1%81%D1%82%D0%B8%D0%B0%D0%BD>.}

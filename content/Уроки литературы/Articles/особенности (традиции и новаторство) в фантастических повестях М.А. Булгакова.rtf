II}{\hich\af5\loch\scaps0\caps0\fs28\b0\f5\loch
. \u1048\'3f\u1089\'3f\u1087\'3f\u1086\'3f\u1083\'3f\u1100\'3f\u1079\'3f\u1086\'3f\u1074\'3f\u1072\'3f\u1085\'3f\u1080\'3f\u1077\'3f \u1092\'3f\u1080\'3f\u1075\'3f\u1091\'3f\u1088\'3f\u1072\'3f\u1083\'3f\u1100\'3f\u1085\'3f\u1086\'3f\u1075\'3f\u1086\'3f \u1076\'3f\u1080\'3f\u1089\'3f\u1082\'3f\u1091\'3f\u1088\'3f\u1089\'3f\u1072\'3f \u1077\'3f\u1089\'3f\u1090\'3f\u1100\'3f \u1087\'3f\u1088\'3f\u1080\'3f\u1079\'3f\u1085\'3f\u1072\'3f\u1082\'3f \u1074\'3f\u1099\'3f\u1089\'3f\u1082\'3f\u1072\'3f\u1079\'3f\u1099\'3f\u1074\'3f\u1072\'3f\u1085\'3f\u1080\'3f\u1103\'3f-\u1088\'3f\u1077\'3f\u1079\'3f\u1091\'3f\u1083\'3f\u1100\'3f\u1090\'3f\u1072\'3f\u1090\'3f\u1072\'3f. \u1055\'3f\u1077\'3f\u1088\'3f\u1077\'3f\u1081\'3f\u1076\'3f\u1077\'3f\u1084\'3f \u1090\'3f\u1077\'3f\u1087\'3f\u1077\'3f\u1088\'3f\u1100\'3f \u1082\'3f \u1074\'3f\u1099\'3f\u1089\'3f\u1082\'3f\u1072\'3f\u1079\'3f\u1099\'3f\u1074\'3f\u1072\'3f\u1085\'3f\u1080\'3f\u1102\'3f-\u1087\'3f\u1088\'3f\u1086\'3f\u1094\'3f\u1077\'3f\u1089\'3f\u1089\'3f\u1091\'3f, \u1095\'3f\u1090\'3f\u1086\'3f\u1073\'3f\u1099\'3f \u1074\'3f\u1099\'3f\u1103\'3f\u1074\'3f\u1080\'3f\u1090\'3f\u1100\'3f \u1074\'3f\u1090\'3f\u1086\'3f\u1088\'3f\u1091\'3f\u1102\'3f \u1089\'3f\u1090\'3f\u1088\'3f\u1091\'3f\u1082\'3f\u1090\'3f\u1091\'3f\u1088\'3f\u1085\'3f\u1091\'3f\u1102\'3f \u1086\'3f\u1089\'3f\u1086\'3f\u1073\'3f\u1077\'3f\u1085\'3f\u1085\'3f\u1086\'3f\u1089\'3f\u1090\'3f\u1100\'3f \u1092\'3f\u1072\'3f\u1085\'3f\u1090\'3f\u1072\'3f\u1089\'3f\u1090\'3f\u1080\'3f\u1095\'3f\u1077\'3f\u1089\'3f\u1082\'3f\u1086\'3f\u1075\'3f\u1086\'3f \u1087\'3f\u1086\'3f\u1074\'3f\u1077\'3f\u1089\'3f\u1090\'3f\u1074\'3f\u1086\'3f\u1074\'3f\u1072\'3f\u1085\'3f\u1080\'3f\u1103\'3f. \u1042\'3f \u1092\'3f\u1072\'3f\u1085\'3f\u1090\'3f\u1072\'3f\u1089\'3f\u1090\'3f\u1080\'3f\u1095\'3f\u1077\'3f\u1089\'3f\u1082\'3f\u1080\'3f\u1093\'3f \u1080\'3f\u1089\'3f\u1090\'3f\u1086\'3f\u1088\'3f\u1080\'3f\u1103\'3f\u1093\'3f \u1088\'3f\u1072\'3f\u1089\'3f\u1089\'3f\u1082\'3f\u1072\'3f\u1079\'3f\u1095\'3f\u1080\'3f\u1082\'3f \u1075\'3f\u1086\'3f\u1074\'3f\u1086\'3f\u1088\'3f\u1080\'3f\u1090\'3f \u1086\'3f\u1073\'3f\u1099\'3f\u1095\'3f\u1085\'3f\u1086\'3f \u171\'ab\u1103\'3f\u187\'bb; \u1101\'3f\u1090\'3f\u1086\'3f\u1090\'3f \u1101\'3f\u1084\'3f\u1087\'3f\u1080\'3f\u1088\'3f\u1080\'3f\u1095\'3f\u1077\'3f\u1089\'3f\u1082\'3f\u1080\'3f\u1081\'3f \u1092\'3f\u1072\'3f\u1082\'3f\u1090\'3f \u1087\'3f\u1088\'3f\u1086\'3f\u1074\'3f\u1077\'3f\u1088\'3f\u1080\'3f\u1090\'3f\u1100\'3f \u1089\'3f\u1086\'3f\u1074\'3f\u1089\'3f\u1077\'3f\u1084\'3f \u1085\'3f\u1077\'3f \u1090\'3f\u1088\'3f\u1091\'3f\u1076\'3f\u1085\'3f\u1086\'3f. \u171\'ab\u1042\'3f\u1083\'3f\u1102\'3f\u1073\'3f\u1083\'3f\u1077\'3f\u1085\'3f\u1085\'3f\u1099\'3f\u1081\'3f \u1076\'3f\u1100\'3f\u1103\'3f\u1074\'3f\u1086\'3f\u1083\'3f\u187\'bb, \u171\'ab\u1056\'3f\u1091\'3f\u1082\'3f\u1086\'3f\u1087\'3f\u1080\'3f\u1089\'3f\u1100\'3f, \u1085\'3f\u1072\'3f\u1081\'3f\u1076\'3f\u1077\'3f\u1085\'3f\u1085\'3f\u1072\'3f\u1103\'3f \u1074\'3f \u1057\'3f\u1072\'3f\u1088\'3f\u1072\'3f\u1075\'3f\u1086\'3f\u1089\'3f\u1077\'3f\u187\'bb, \u171\'ab\u1040\'3f\u1074\'3f\u1088\'3f\u1077\'3f\u1083\'3f\u1080\'3f\u1103\'3f\u187\'bb, \u1088\'3f\u1072\'3f\u1089\'3f\u1089\'3f\u1082\'3f\u1072\'3f\u1079\'3f\u1099\'3f \u1058\'3f. \u1043\'3f\u1086\'3f\u1090\'3f\u1100\'3f\u1077\'3f, \u1069\'3f. \u1055\'3f\u1086\'3f, \u171\'ab\u1042\'3f\u1077\'3f\u1085\'3f\u1077\'3f\u1088\'3f\u1072\'3f \u1048\'3f\u1083\'3f\u1083\'3f\u1100\'3f\u1089\'3f\u1082\'3f\u1072\'3f\u1103\'3f\u187\'bb \u1055\'3f. \u1052\'3f\u1077\'3f\u1088\'3f\u1080\'3f\u1084\'3f\u1077\'3f, \u171\'ab\u1048\'3f\u1085\'3f\u1077\'3f\u1077\'3f \u1076\'3f\u1077\'3f \u1051\'3f\u1072\'3f\u1089\'3f \u1057\'3f\u1100\'3f\u1077\'3f\u1088\'3f\u1088\'3f\u1072\'3f\u1089\'3f\u187\'bb \u1064\'3f. \u1053\'3f\u1086\'3f\u1076\'3f\u1100\'3f\u1077\'3f, \u1085\'3f\u1086\'3f\u1074\'3f\u1077\'3f\u1083\'3f\u1083\'3f\u1099\'3f \u1052\'3f\u1086\'3f\u1087\'3f\u1072\'3f\u1089\'3f\u1089\'3f\u1072\'3f\u1085\'3f\u1072\'3f, \u1085\'3f\u1077\'3f\u1082\'3f\u1086\'3f\u1090\'3f\u1086\'3f\u1088\'3f\u1099\'3f\u1077\'3f \u1087\'3f\u1088\'3f\u1086\'3f\u1080\'3f\u1079\'3f\u1074\'3f\u1077\'3f\u1076\'3f\u1077\'3f\u1085\'3f\u1080\'3f\u1103\'3f \u1043\'3f\u1086\'3f\u1092\'3f\u1084\'3f\u1072\'3f\u1085\'3f\u1072\'3f- \u1074\'3f\u1089\'3f\u1077\'3f \u1086\'3f\u1085\'3f\u1080\'3f \u1087\'3f\u1086\'3f\u1076\'3f\u1095\'3f\u1080\'3f\u1085\'3f\u1103\'3f\u1102\'3f\u1090\'3f\u1089\'3f\u1103\'3f \u1101\'3f\u1090\'3f\u1086\'3f\u1084\'3f\u1091\'3f \u1087\'3f\u1088\'3f\u1072\'3f\u1074\'3f\u1080\'3f\u1083\'3f\u1091\'3f. \u1048\'3f\u1089\'3f\u1082\'3f\u1083\'3f\u1102\'3f\u1095\'3f\u1077\'3f\u1085\'3f\u1080\'3f\u1103\'3f - \u1101\'3f\u1090\'3f\u1086\'3f \u1087\'3f\u1086\'3f\u1095\'3f\u1090\'3f\u1080\'3f \u1074\'3f\u1089\'3f\u1077\'3f\u1075\'3f\u1076\'3f\u1072\'3f \u1090\'3f\u1072\'3f\u1082\'3f\u1080\'3f\u1077\'3f \u1090\'3f\u1077\'3f\u1082\'3f\u1089\'3f\u1090\'3f\u1099\'3f, \u1082\'3f\u1086\'3f\u1090\'3f\u1086\'3f\u1088\'3f\u1099\'3f\u1077\'3f \u1086\'3f\u1090\'3f\u1082\'3f\u1083\'3f\u1086\'3f\u1085\'3f\u1103\'3f\u1102\'3f\u1090\'3f\u1089\'3f\u1103\'3f \u1086\'3f\u1090\'3f \u1092\'3f\u1072\'3f\u1085\'3f\u1090\'3f\u1072\'3f\u1089\'3f\u1090\'3f\u1080\'3f\u1095\'3f\u1077\'3f\u1089\'3f\u1082\'3f\u1086\'3f\u1075\'3f\u1086\'3f \u1078\'3f\u1072\'3f\u1085\'3f\u1088\'3f\u1072\'3f \u1090\'3f\u1072\'3f\u1082\'3f\u1078\'3f\u1077\'3f \u1080\'3f \u1074\'3f\u1086\'3f \u1084\'3f\u1085\'3f\u1086\'3f\u1075\'3f\u1080\'3f\u1093\'3f \u1076\'3f\u1088\'3f\u1091\'3f\u1075\'3f\u1080\'3f\u1093\'3f \u1086\'3f\u1090\'3f\u1085\'3f\u1086\'3f\u1096\'3f\u1077\'3f\u1085\'3f\u1080\'3f\u1103\'3f\u1093\'3f.}

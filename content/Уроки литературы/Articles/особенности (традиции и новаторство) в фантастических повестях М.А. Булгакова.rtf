\u1042\'3f \u1083\'3f\u1077\'3f\u1085\'3f\u1080\'3f\u1085\'3f\u1089\'3f\u1082\'3f\u1086\'3f\u1084\'3f \u1082\'3f\u1086\'3f\u1085\'3f\u1090\'3f\u1077\'3f\u1082\'3f\u1089\'3f\u1090\'3f\u1077\'3f \u1086\'3f\u1073\'3f\u1088\'3f\u1072\'3f\u1079\'3f\u1072\'3f \u1055\'3f\u1077\'3f\u1088\'3f\u1089\'3f\u1080\'3f\u1082\'3f\u1086\'3f\u1074\'3f\u1072\'3f \u1085\'3f\u1072\'3f\u1093\'3f\u1086\'3f\u1076\'3f\u1080\'3f\u1090\'3f \u1089\'3f\u1074\'3f\u1086\'3f\u1077\'3f \u1086\'3f\u1073\'3f\u1098\'3f\u1103\'3f\u1089\'3f\u1085\'3f\u1077\'3f\u1085\'3f\u1080\'3f\u1077\'3f \u1079\'3f\u1072\'3f\u1075\'3f\u1088\'3f\u1072\'3f\u1085\'3f\u1080\'3f\u1095\'3f\u1085\'3f\u1086\'3f\u1077\'3f, \u1072\'3f \u1082\'3f\u1086\'3f\u1085\'3f\u1082\'3f\u1088\'3f\u1077\'3f\u1090\'3f\u1085\'3f\u1086\'3f: \u1085\'3f\u1077\'3f\u1084\'3f\u1077\'3f\u1094\'3f\u1082\'3f\u1086\'3f\u1077\'3f, \u1089\'3f\u1091\'3f\u1076\'3f\u1103\'3f \u1087\'3f\u1086\'3f \u1085\'3f\u1072\'3f\u1076\'3f\u1087\'3f\u1080\'3f\u1089\'3f\u1103\'3f\u1084\'3f \u1085\'3f\u1072\'3f \u1103\'3f\u1097\'3f\u1080\'3f\u1082\'3f\u1072\'3f\u1093\'3f, \u1087\'3f\u1088\'3f\u1086\'3f\u1080\'3f\u1089\'3f\u1093\'3f\u1086\'3f\u1078\'3f\u1076\'3f\u1077\'3f\u1085\'3f\u1080\'3f\u1077\'3f \u1103\'3f\u1080\'3f\u1094\'3f \u1075\'3f\u1072\'3f\u1076\'3f\u1086\'3f\u1074\'3f, \u1082\'3f\u1086\'3f\u1090\'3f\u1086\'3f\u1088\'3f\u1099\'3f\u1077\'3f \u1087\'3f\u1086\'3f\u1090\'3f\u1086\'3f\u1084\'3f \u1087\'3f\u1086\'3f\u1076\'3f \u1076\'3f\u1077\'3f\u1081\'3f\u1089\'3f\u1090\'3f\u1074\'3f\u1080\'3f\u1077\'3f\u1084\'3f \u1082\'3f\u1088\'3f\u1072\'3f\u1089\'3f\u1085\'3f\u1086\'3f\u1075\'3f\u1086\'3f \u1083\'3f\u1091\'3f\u1095\'3f\u1072\'3f \u1095\'3f\u1091\'3f\u1090\'3f\u1100\'3f \u1085\'3f\u1077\'3f \u1079\'3f\u1072\'3f\u1093\'3f\u1074\'3f\u1072\'3f\u1090\'3f\u1080\'3f\u1083\'3f\u1080\'3f (\u1072\'3f \u1074\'3f \u1087\'3f\u1077\'3f\u1088\'3f\u1074\'3f\u1086\'3f\u1081\'3f \u1088\'3f\u1077\'3f\u1076\'3f\u1072\'3f\u1082\'3f\u1094\'3f\u1080\'3f\u1080\'3f \u8220\'93\u1056\'3f\u1086\'3f\u1082\'3f\u1086\'3f\u1074\'3f\u1099\'3f\u1077\'3f \u1103\'3f\u1081\'3f\u1094\'3f\u1072\'3f\u8221\'94 \u1076\'3f\u1072\'3f\u1078\'3f\u1077\'3f \u1079\'3f\u1072\'3f\u1093\'3f\u1074\'3f\u1072\'3f\u1090\'3f\u1080\'3f\u1083\'3f\u1080\'3f) \u1052\'3f\u1086\'3f\u1089\'3f\u1082\'3f\u1074\'3f\u1091\'3f. \u1048\'3f\u1079\'3f\u1074\'3f\u1077\'3f\u1089\'3f\u1090\'3f\u1085\'3f\u1086\'3f, \u1095\'3f\u1090\'3f\u1086\'3f \u1051\'3f\u1077\'3f\u1085\'3f\u1080\'3f\u1085\'3f \u1080\'3f \u1077\'3f\u1075\'3f\u1086\'3f \u1090\'3f\u1086\'3f\u1074\'3f\u1072\'3f\u1088\'3f\u1080\'3f\u1097\'3f\u1080\'3f \u1087\'3f\u1086\'3f\u1089\'3f\u1083\'3f\u1077\'3f \u1060\'3f\u1077\'3f\u1074\'3f\u1088\'3f\u1072\'3f\u1083\'3f\u1100\'3f\u1089\'3f\u1082\'3f\u1086\'3f\u1081\'3f \u1088\'3f\u1077\'3f\u1074\'3f\u1086\'3f\u1083\'3f\u1102\'3f\u1094\'3f\u1080\'3f\u1080\'3f \u1073\'3f\u1099\'3f\u1083\'3f\u1080\'3f \u1087\'3f\u1077\'3f\u1088\'3f\u1077\'3f\u1087\'3f\u1088\'3f\u1072\'3f\u1074\'3f\u1083\'3f\u1077\'3f\u1085\'3f\u1099\'3f \u1080\'3f\u1079\'3f \u1064\'3f\u1074\'3f\u1077\'3f\u1081\'3f\u1094\'3f\u1072\'3f\u1088\'3f\u1080\'3f\u1080\'3f \u1074\'3f \u1056\'3f\u1086\'3f\u1089\'3f\u1089\'3f\u1080\'3f\u1102\'3f \u1095\'3f\u1077\'3f\u1088\'3f\u1077\'3f\u1079\'3f \u1043\'3f\u1077\'3f\u1088\'3f\u1084\'3f\u1072\'3f\u1085\'3f\u1080\'3f\u1102\'3f \u1074\'3f \u1079\'3f\u1072\'3f\u1087\'3f\u1083\'3f\u1086\'3f\u1084\'3f\u1073\'3f\u1080\'3f\u1088\'3f\u1086\'3f\u1074\'3f\u1072\'3f\u1085\'3f\u1085\'3f\u1086\'3f\u1084\'3f \u1074\'3f\u1072\'3f\u1075\'3f\u1086\'3f\u1085\'3f\u1077\'3f (\u1085\'3f\u1077\'3f\u1076\'3f\u1072\'3f\u1088\'3f\u1086\'3f\u1084\'3f \u1087\'3f\u1086\'3f\u1076\'3f\u1095\'3f\u1077\'3f\u1088\'3f\u1082\'3f\u1080\'3f\u1074\'3f\u1072\'3f\u1077\'3f\u1090\'3f\u1089\'3f\u1103\'3f, \u1095\'3f\u1090\'3f\u1086\'3f \u1087\'3f\u1088\'3f\u1080\'3f\u1073\'3f\u1099\'3f\u1074\'3f\u1096\'3f\u1080\'3f\u1077\'3f \u1082\'3f \u1056\'3f\u1086\'3f\u1082\'3f\u1082\'3f\u1091\'3f \u1103\'3f\u1081\'3f\u1094\'3f\u1072\'3f, \u1082\'3f\u1086\'3f\u1090\'3f\u1086\'3f\u1088\'3f\u1099\'3f\u1077\'3f \u1086\'3f\u1085\'3f \u1087\'3f\u1088\'3f\u1080\'3f\u1085\'3f\u1080\'3f\u1084\'3f\u1072\'3f\u1077\'3f\u1090\'3f \u1079\'3f\u1072\'3f \u1082\'3f\u1091\'3f\u1088\'3f\u1080\'3f\u1085\'3f\u1099\'3f\u1077\'3f, \u1082\'3f\u1088\'3f\u1091\'3f\u1075\'3f\u1086\'3f\u1084\'3f \u1086\'3f\u1082\'3f\u1083\'3f\u1077\'3f\u1077\'3f\u1085\'3f\u1099\'3f \u1103\'3f\u1088\'3f\u1083\'3f\u1099\'3f\u1082\'3f\u1072\'3f\u1084\'3f\u1080\'3f). \u1051\'3f\u1102\'3f\u1073\'3f\u1086\'3f\u1087\'3f\u1099\'3f\u1090\'3f\u1085\'3f\u1086\'3f, \u1095\'3f\u1090\'3f\u1086\'3f \u1091\'3f\u1087\'3f\u1086\'3f\u1076\'3f\u1086\'3f\u1073\'3f\u1083\'3f\u1077\'3f\u1085\'3f\u1080\'3f\u1077\'3f \u1073\'3f\u1086\'3f\u1083\'3f\u1100\'3f\u1096\'3f\u1077\'3f\u1074\'3f\u1080\'3f\u1082\'3f\u1086\'3f\u1074\'3f \u1075\'3f\u1080\'3f\u1075\'3f\u1072\'3f\u1085\'3f\u1090\'3f\u1089\'3f\u1082\'3f\u1080\'3f\u1084\'3f \u1075\'3f\u1072\'3f\u1076\'3f\u1072\'3f\u1084\'3f, \u1080\'3f\u1076\'3f\u1091\'3f\u1097\'3f\u1080\'3f\u1084\'3f \u1087\'3f\u1086\'3f\u1093\'3f\u1086\'3f\u1076\'3f\u1086\'3f\u1084\'3f \u1085\'3f\u1072\'3f \u1052\'3f\u1086\'3f\u1089\'3f\u1082\'3f\u1074\'3f\u1091\'3f, \u1073\'3f\u1099\'3f\u1083\'3f\u1086\'3f \u1089\'3f\u1076\'3f\u1077\'3f\u1083\'3f\u1072\'3f\u1085\'3f\u1086\'3f \u1077\'3f\u1097\'3f\u1077\'3f \u1074\'3f \u1087\'3f\u1080\'3f\u1089\'3f\u1100\'3f\u1084\'3f\u1077\'3f \u1073\'3f\u1077\'3f\u1079\'3f\u1099\'3f\u1084\'3f\u1103\'3f\u1085\'3f\u1085\'3f\u1086\'3f\u1081\'3f \u1087\'3f\u1088\'3f\u1086\'3f\u1085\'3f\u1080\'3f\u1094\'3f\u1072\'3f\u1090\'3f\u1077\'3f\u1083\'3f\u1100\'3f\u1085\'3f\u1086\'3f\u1081\'3f \u1073\'3f\u1091\'3f\u1083\'3f\u1075\'3f\u1072\'3f\u1082\'3f\u1086\'3f\u1074\'3f\u1089\'3f\u1082\'3f\u1086\'3f\u1081\'3f \u1095\'3f\u1080\'3f\u1090\'3f\u1072\'3f\u1090\'3f\u1077\'3f\u1083\'3f\u1100\'3f\u1085\'3f\u1080\'3f\u1094\'3f\u1099\'3f \u1074\'3f \u1087\'3f\u1080\'3f\u1089\'3f\u1100\'3f\u1084\'3f\u1077\'3f 9 \u1084\'3f\u1072\'3f\u1088\'3f\u1090\'3f\u1072\'3f 1936 \u1075\'3f.: "\u1059\'3f\u1074\'3f\u1072\'3f\u1078\'3f\u1072\'3f\u1077\'3f\u1084\'3f\u1099\'3f\u1081\'3f \u1041\'3f\u1091\'3f\u1083\'3f\u1075\'3f\u1072\'3f\u1082\'3f\u1086\'3f\u1074\'3f! \u1055\'3f\u1077\'3f\u1095\'3f\u1072\'3f\u1083\'3f\u1100\'3f\u1085\'3f\u1099\'3f\u1081\'3f \u1082\'3f\u1086\'3f\u1085\'3f\u1077\'3f\u1094\'3f \u1042\'3f\u1072\'3f\u1096\'3f\u1077\'3f\u1075\'3f\u1086\'3f \u1052\'3f\u1086\'3f\u1083\'3f\u1100\'3f\u1077\'3f\u1088\'3f\u1072\'3f \u1042\'3f\u1099\'3f \u1087\'3f\u1088\'3f\u1077\'3f\u1076\'3f\u1089\'3f\u1082\'3f\u1072\'3f\u1079\'3f\u1072\'3f\u1083\'3f\u1080\'3f \u1089\'3f\u1072\'3f\u1084\'3f\u1080\'3f: \u1074\'3f \u1095\'3f\u1080\'3f\u1089\'3f\u1083\'3f\u1077\'3f \u1087\'3f\u1088\'3f\u1086\'3f\u1095\'3f\u1080\'3f\u1093\'3f \u1075\'3f\u1072\'3f\u1076\'3f\u1086\'3f\u1074\'3f, \u1085\'3f\u1077\'3f\u1089\'3f\u1086\'3f\u1084\'3f\u1085\'3f\u1077\'3f\u1085\'3f\u1085\'3f\u1086\'3f, \u1080\'3f\u1079\'3f \u1088\'3f\u1086\'3f\u1082\'3f\u1086\'3f\u1074\'3f\u1086\'3f\u1075\'3f\u1086\'3f \u1103\'3f\u1081\'3f\u1094\'3f\u1072\'3f \u1074\'3f\u1099\'3f\u1083\'3f\u1091\'3f\u1087\'3f\u1080\'3f\u1083\'3f\u1072\'3f\u1089\'3f\u1100\'3f \u1080\'3f \u1085\'3f\u1077\'3f\u1089\'3f\u1074\'3f\u1086\'3f\u1073\'3f\u1086\'3f\u1076\'3f\u1085\'3f\u1072\'3f\u1103\'3f \u1087\'3f\u1077\'3f\u1095\'3f\u1072\'3f\u1090\'3f\u1100\'3f".}
\par \pard\plain \s0\rtlch\af10\afs24\alang1081 \ltrch\lang1049\langfe2052\hich\af6\loch\ql\nowidctlpar\hyphpar0\ltrpar\cf0\f6\fs24\lang1049\kerning1\dbch\af9\langfe2052\sl360\slmult1\qj\li0\ri0\lin0\rin0\fi709\cbpat8{\hich\af5\loch\scaps0\caps0\fs28\b0\f5\loch
\u1057\'3f\u1088\'3f\u1077\'3f\u1076\'3f\u1080\'3f \u1087\'3f\u1088\'3f\u1086\'3f\u1090\'3f\u1086\'3f\u1090\'3f\u1080\'3f\u1087\'3f\u1086\'3f\u1074\'3f \u1055\'3f\u1077\'3f\u1088\'3f\u1089\'3f\u1080\'3f\u1082\'3f\u1086\'3f\u1074\'3f\u1072\'3f \u1073\'3f\u1099\'3f\u1083\'3f \u1090\'3f\u1072\'3f\u1082\'3f\u1078\'3f\u1077\'3f \u1080\'3f\u1079\'3f\u1074\'3f\u1077\'3f\u1089\'3f\u1090\'3f\u1085\'3f\u1099\'3f\u1081\'3f \u1073\'3f\u1080\'3f\u1086\'3f\u1083\'3f\u1086\'3f\u1075\'3f \u1080\'3f \u1087\'3f\u1072\'3f\u1090\'3f\u1086\'3f\u1083\'3f\u1086\'3f\u1075\'3f\u1086\'3f\u1072\'3f\u1085\'3f\u1072\'3f\u1090\'3f\u1086\'3f\u1084\'3f \u1040\'3f\u1083\'3f\u1077\'3f\u1082\'3f\u1089\'3f\u1077\'3f\u1081\'3f \u1048\'3f\u1074\'3f\u1072\'3f\u1085\'3f\u1086\'3f\u1074\'3f\u1080\'3f\u1095\'3f \u1040\'3f\u1073\'3f\u1088\'3f\u1080\'3f\u1082\'3f\u1086\'3f\u1089\'3f\u1086\'3f\u1074\'3f (1875-1955), \u1095\'3f\u1100\'3f\u1103\'3f \u1092\'3f\u1072\'3f\u1084\'3f\u1080\'3f\u1083\'3f\u1080\'3f\u1103\'3f \u1089\'3f\u1087\'3f\u1072\'3f\u1088\'3f\u1086\'3f\u1076\'3f\u1080\'3f\u1088\'3f\u1086\'3f\u1074\'3f\u1072\'3f\u1085\'3f\u1072\'3f \u1074\'3f \u1092\'3f\u1072\'3f\u1084\'3f\u1080\'3f\u1083\'3f\u1080\'3f\u1080\'3f \u1075\'3f\u1083\'3f\u1072\'3f\u1074\'3f\u1085\'3f\u1086\'3f\u1075\'3f\u1086\'3f \u1075\'3f\u1077\'3f\u1088\'3f\u1086\'3f\u1103\'3f \u1087\'3f\u1086\'3f\u1074\'3f\u1077\'3f\u1089\'3f\u1090\'3f\u1080\'3f \u8220\'93\u1056\'3f\u1086\'3f\u1082\'3f\u1086\'3f\u1074\'3f\u1099\'3f\u1077\'3f \u1103\'3f\u1081\'3f\u1094\'3f\u1072\'3f\u8221\'94 \u1048\'3f \u1089\'3f\u1087\'3f\u1072\'3f\u1088\'3f\u1086\'3f\u1076\'3f\u1080\'3f\u1088\'3f\u1086\'3f\u1074\'3f\u1072\'3f\u1085\'3f\u1072\'3f \u1086\'3f\u1085\'3f\u1072\'3f \u1085\'3f\u1077\'3f\u1089\'3f\u1083\'3f\u1091\'3f\u1095\'3f\u1072\'3f\u1081\'3f\u1085\'3f\u1086\'3f, \u1080\'3f\u1073\'3f\u1086\'3f \u1082\'3f\u1072\'3f\u1082\'3f \u1088\'3f\u1072\'3f\u1079\'3f \u1040\'3f\u1073\'3f\u1088\'3f\u1080\'3f\u1082\'3f\u1086\'3f\u1089\'3f\u1086\'3f\u1074\'3f \u1072\'3f\u1085\'3f\u1072\'3f\u1090\'3f\u1086\'3f\u1084\'3f\u1080\'3f\u1088\'3f\u1086\'3f\u1074\'3f\u1072\'3f\u1083\'3f \u1090\'3f\u1088\'3f\u1091\'3f\u1087\'3f \u1051\'3f\u1077\'3f\u1085\'3f\u1080\'3f\u1085\'3f\u1072\'3f \u1080\'3f \u1080\'3f\u1079\'3f\u1074\'3f\u1083\'3f\u1077\'3f\u1082\'3f \u1077\'3f\u1075\'3f\u1086\'3f \u1084\'3f\u1086\'3f\u1079\'3f\u1075\'3f. \u1042\'3f \u1087\'3f\u1086\'3f\u1074\'3f\u1077\'3f\u1089\'3f\u1090\'3f\u1080\'3f \u8220\'93\u1056\'3f\u1086\'3f\u1082\'3f\u1086\'3f\u1074\'3f\u1099\'3f\u1077\'3f \u1103\'3f\u1081\'3f\u1094\'3f\u1072\'3f\u8221\'94 \u1101\'3f\u1090\'3f\u1086\'3f\u1090\'3f \u1084\'3f\u1086\'3f\u1079\'3f\u1075\'3f \u1082\'3f\u1072\'3f\u1082\'3f \u1073\'3f\u1099\'3f \u1087\'3f\u1077\'3f\u1088\'3f\u1077\'3f\u1076\'3f\u1072\'3f\u1085\'3f \u1080\'3f\u1079\'3f\u1074\'3f\u1083\'3f\u1077\'3f\u1082\'3f\u1096\'3f\u1077\'3f\u1084\'3f\u1091\'3f \u1077\'3f\u1075\'3f\u1086\'3f \u1091\'3f\u1095\'3f\u1077\'3f\u1085\'3f\u1086\'3f\u1084\'3f\u1091\'3f, \u1074\'3f \u1086\'3f\u1090\'3f\u1083\'3f\u1080\'3f\u1095\'3f\u1080\'3f\u1077\'3f \u1086\'3f\u1090\'3f \u1073\'3f\u1086\'3f\u1083\'3f\u1100\'3f\u1096\'3f\u1077\'3f\u1074\'3f\u1080\'3f\u1082\'3f\u1086\'3f\u1074\'3f, \u1095\'3f\u1077\'3f\u1083\'3f\u1086\'3f\u1074\'3f\u1077\'3f\u1082\'3f\u1091\'3f \u1084\'3f\u1103\'3f\u1075\'3f\u1082\'3f\u1086\'3f\u1084\'3f\u1091\'3f, \u1072\'3f \u1085\'3f\u1077\'3f \u1078\'3f\u1077\'3f\u1089\'3f\u1090\'3f\u1086\'3f\u1082\'3f\u1086\'3f\u1084\'3f\u1091\'3f, \u1080\'3f \u1091\'3f\u1074\'3f\u1083\'3f\u1077\'3f\u1095\'3f\u1077\'3f\u1085\'3f\u1085\'3f\u1086\'3f\u1084\'3f\u1091\'3f \u1076\'3f\u1086\'3f \u1089\'3f\u1072\'3f\u1084\'3f\u1086\'3f\u1079\'3f\u1072\'3f\u1073\'3f\u1074\'3f\u1077\'3f\u1085\'3f\u1080\'3f\u1103\'3f \u1079\'3f\u1086\'3f\u1086\'3f\u1083\'3f\u1086\'3f\u1075\'3f\u1080\'3f\u1077\'3f\u1081\'3f, \u1072\'3f \u1085\'3f\u1077\'3f \u1089\'3f\u1086\'3f\u1094\'3f\u1080\'3f\u1072\'3f\u1083\'3f\u1080\'3f\u1089\'3f\u1090\'3f\u1080\'3f\u1095\'3f\u1077\'3f\u1089\'3f\u1082\'3f\u1086\'3f\u1081\'3f \u1088\'3f\u1077\'3f\u1074\'3f\u1086\'3f\u1083\'3f\u1102\'3f\u1094\'3f\u1080\'3f\u1077\'3f\u1081\'3f.}
